<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".RecipeActivity">

    <!-- Toolbar morada (la flecha atrás se activa en Kotlin) -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/recipeToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:title="Suggest a Recipe"
        app:titleTextColor="?attr/colorOnPrimary" />

    <!-- Receta con scroll -->
    <ScrollView
        android:id="@+id/recipeScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <TextView
            android:id="@+id/recipeTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.2"
            android:padding="16dp"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textIsSelectable="true"
            tools:text="# Tortilla de patatas\n\n**Ingredients**\n- 6 eggs\n- 3 potatoes" />

    </ScrollView>

</LinearLayout>